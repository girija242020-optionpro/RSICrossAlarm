# Server
PORT=10000
CORS_ORIGIN=*

# Angel One SmartAPI credentials (keep private; never put these in the PWA)
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=

# Optional public IP/header values; defaults are suitable for many deployments
ANGELONE_CLIENT_LOCAL_IP=127.0.0.1
ANGELONE_CLIENT_PUBLIC_IP=127.0.0.1
ANGELONE_MAC_ADDRESS=00:00:00:00:00:00

# Instrument tokens; confirm these against your Angel One instrument master
NIFTY_TOKEN=99926000
NIFTY_EXCHANGE=NSE
SENSEX_TOKEN=99919000
SENSEX_EXCHANGE=BSE

# RSI logic
RSI_LENGTH=14
RSI_SMA_LENGTH=14
RSI_LOWER_LIMIT=30
DEFAULT_TIMEFRAME=ONE_MINUTE
POLL_INTERVAL_MS=20000

# Web Push VAPID values. Generate your own pair; do not use example/fake keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
