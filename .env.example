# Angel One SmartAPI credentials — keep these on the backend only
ANGELONE_API_KEY=replace_with_angel_one_api_key
ANGELONE_CLIENT_CODE=replace_with_client_code
ANGELONE_PIN=replace_with_trading_pin
ANGELONE_TOTP_SECRET=replace_with_totp_secret

# Index symbol tokens can be overridden if your Angel One instrument master differs
NIFTY_EXCHANGE=NSE
NIFTY_SYMBOL_TOKEN=99926000
SENSEX_EXCHANGE=BSE
SENSEX_SYMBOL_TOKEN=99919000

# Web Push (generate using: python generate_vapid.py)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_B64=
VAPID_SUBJECT=mailto:your-email@example.com

# Monitor and RSI settings
ENABLE_PUSH_MONITOR=true
MONITOR_SYMBOLS=NIFTY
MONITOR_TIMEFRAME=1m
MONITOR_INTERVAL_SEC=20
RSI_LENGTH=14
RSI_SMA_LENGTH=14
RSI_LOWER_LIMIT=30

# Render/runtime
PORT=10000
CORS_ORIGINS=*
# For durable SQLite storage, mount a Render disk and set DATABASE_PATH to its mount path.
DATABASE_PATH=./rsi_alarm.sqlite3
LOG_LEVEL=INFO
